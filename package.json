{
  "name": "gennext",
  "version": "0.1.0",
  "description": "A Rails-like CLI for building full-stack Next.js apps faster",
  "keywords": [
    "cli",
    "nextjs",
    "drizzle",
    "better-auth",
    "rails",
    "shadcn"
  ],
  "homepage": "https://github.com/scottjones-dev/gennext#readme",
  "bugs": {
    "url": "https://github.com/scottjones-dev/gennext/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scottjones-dev/gennext.git"
  },
  "license": "MIT",
  "author": "Scott Jones",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gennext": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "ultracite check",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -w",
    "dev2": "node dist/index.js",
    "fix": "ultracite fix",
    "prepublishOnly": "npm run clean && npm run build && npm run check && npm run typecheck && npm test",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "^3.0.1",
    "chalk": "^5.3.0",
    "commander": "^11.0.0",
    "consola": "^3.2.3",
    "execa": "^8.0.1",
    "figlet": "^1.7.0",
    "ora": "^8.0.1",
    "pluralize": "^8.0.0",
    "strip-json-comments": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.10.1",
    "typescript": "^5.1.6",
    "ultracite": "7.11.1"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.19.0"
  }
}
